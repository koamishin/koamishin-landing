---
---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="#top"><img src="/koamishin-logo.png" alt="Koamishin logo" class="brand-logo" width="34" height="34" />Koamishin<small>Collective</small></a>
    <nav aria-label="Primary">
      <ul class="nav-links">
        <li><a href="#hackathon">Hackathon</a></li>
        <li><a href="#quickstart">Quickstart</a></li>
        <li><a href="#projects">Projects</a></li>
        <li class="has-mega">
          <button type="button" aria-expanded="false" aria-haspopup="true" data-mega>Learn <span class="caret">▾</span></button>
          <div class="mega" role="menu">
            <div class="mega-grid">
              <div class="mega-col">
                <h6>Get Started</h6>
                <ul>
                  <li><a href="#quickstart"><b>Quickstart</b><span>Spin up in minutes</span></a></li>
                  <li><a href="#projects"><b>Starter Kits</b><span>Laravel 12 + Vue 3</span></a></li>
                  <li><a href="#projects"><b>Installation</b><span>Composer &amp; npm</span></a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h6>Learn</h6>
                <ul>
                  <li><a href="#projects"><b>Tutorials</b><span>Step-by-step guides</span></a></li>
                  <li><a href="#projects"><b>Guides</b><span>Best practices</span></a></li>
                  <li><a href="#team"><b>Courses</b><span>KoAcademy</span></a></li>
                </ul>
              </div>
              <div class="mega-col">
                <h6>Community</h6>
                <ul>
                  <li><a href="#team"><b>The Team</b><span>Our collective</span></a></li>
                  <li><a href="https://github.com/koamishin" target="_blank" rel="noopener"><b>Discussions</b><span>GitHub community</span></a></li>
                  <li><a href="#contact"><b>Discord</b><span>Chat with us</span></a></li>
                </ul>
              </div>
              <div class="mega-feature">
                <div><b>New: KoamiStarterKit v2</b><br /><span>Laravel 12, Inertia, Tailwind 4 — production-ready.</span></div>
                <a href="https://github.com/koamishin/KoamiStarterKit" target="_blank" rel="noopener">Read the docs →</a>
              </div>
            </div>
          </div>
        </li>
        <li><a href="#team">Team</a></li>
        <li><a href="#testimonials">Stories</a></li>
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="btn btn-ghost" href="https://github.com/koamishin" target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn-primary" href="#join"><span class="btn-text-full">Join Collective</span><span class="btn-text-short">Join</span></a>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 200;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .brand {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    flex-shrink: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links > li > a,
  .nav-links > li > button {
    white-space: nowrap;
    padding: 0.42rem 0.65rem;
    font-size: 0.88rem;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-cta .btn {
    padding: 0.5rem 1.15rem !important;
    font-size: 0.86rem !important;
    font-weight: 600 !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    border-radius: 999px !important;
  }

  .nav-cta .btn-primary {
    padding: 0.5rem 1.25rem !important;
    background: var(--coral) !important;
    color: #fff !important;
    box-shadow: 0 4px 14px -3px rgba(60, 77, 61, 0.4) !important;
  }

  .btn-text-short {
    display: none;
  }

  .btn-text-full {
    display: inline;
  }

  @media (max-width: 1120px) {
    .nav-links > li > a,
    .nav-links > li > button {
      padding: 0.38rem 0.5rem;
      font-size: 0.82rem;
    }
    .brand small {
      display: none;
    }
    .nav-cta .btn {
      padding: 0.45rem 0.95rem !important;
      font-size: 0.82rem !important;
    }
  }

  @media (max-width: 980px) {
    .btn-text-full {
      display: none;
    }
    .btn-text-short {
      display: inline;
    }
    .nav-links > li > a,
    .nav-links > li > button {
      padding: 0.32rem 0.4rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .nav {
      height: 64px;
    }
  }

  @media (max-width: 480px) {
    .nav-cta .btn-ghost {
      display: none;
    }
    .nav-cta .btn-primary {
      padding: 0.42rem 0.85rem !important;
      font-size: 0.78rem !important;
    }
  }
</style>
