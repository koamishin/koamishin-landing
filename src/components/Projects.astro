---
const repos = [
  {
    name: 'KoamiStarterKit',
    img: '/repos/KoamiStarterKit.png',
    url: 'https://github.com/koamishin/KoamiStarterKit',
    desc: 'An opinionated Laravel 12 starter kit with Vue 3, Inertia.js, Tailwind CSS, Fortify authentication and Wayfinder routing — Octane, Pest and CI/CD out of the box.',
    lang: 'Vue', stars: 5, featured: true,
  },
  {
    name: 'KoaScholarships',
    img: '/repos/KoaScholarships.png',
    url: 'https://github.com/koamishin/KoaScholarships',
    desc: 'Scholarship management for students and admins — application portal, review dashboard, fund & budget management, and automated email notifications.',
    lang: 'TypeScript', stars: 0, featured: false,
  },
  {
    name: 'koakademy',
    img: '/repos/koakademy.png',
    url: 'https://github.com/yukazakiri/koakademy',
    desc: 'An opinionated academic management platform covering the full student lifecycle — enrollment, billing, scheduling and admin tools on Laravel 12, Inertia React & Tailwind CSS, with configurable branding and PWA support.',
    lang: 'TypeScript', stars: 6, featured: false,
  },
  {
    name: 'konexus',
    img: '/repos/konexus.png',
    url: 'https://github.com/elyashzyl/konexus',
    desc: 'Enterprise-grade, modular School Management Information System (SMIS) — a full-featured platform for running schools, built by the Koamishin collective on Laravel and Inertia.',
    lang: 'PHP', stars: 0, featured: false,
  },
  {
    name: 'finance-tracker',
    img: '/repos/finance-tracker.png',
    url: 'https://github.com/SorenOutis/finance-tracker',
    desc: 'A personal finance tracker on Laravel 12, Inertia.js and Vue 3 — log income and expenses, visualize spending with interactive charts, all wrapped in a custom design system.',
    lang: 'Vue', stars: 1, featured: false,
  },
  {
    name: 'luav6',
    img: '/repos/luav6.png',
    url: 'https://github.com/SorenOutis/luav6',
    desc: 'A modern full-stack Laravel 12 + Vue 3 app with Inertia.js — Octane (FrankenPHP), Fortify auth, Filament admin, AI integration, PDF processing and GSAP animations out of the box.',
    lang: 'Vue', stars: 1, featured: false,
  },
  {
    name: 'shadcthemes-tools',
    img: '/repos/shadcthemes-tools.png',
    url: 'https://github.com/yukazakiri/shadcthemes-tools',
    desc: 'Powerful Artisan commands to seamlessly integrate and manage tweakcn / shadcn themes in your Laravel Inertia applications — supports both Inertia React and Inertia Vue.',
    lang: 'PHP', stars: 1, featured: false,
  },
];
---
<section class="section" id="projects">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">The Shelf</span>
      <h2 class="section-title">Featured <em>repositories</em></h2>
      <p class="lede">Top open-source projects from the Koamishin collective on GitHub — each one documented, tested, and free to fork. Social previews pulled live from each repository.</p>
    </div>
    <div class="repo-grid">
      {repos.map((r) => (
        <a class="repo-card" href={r.url} target="_blank" rel="noopener" data-reveal>
          {r.featured && <span class="repo-badge">★ Featured</span>}
          <div class="repo-cover">
            <img src={r.img} alt={`${r.name} repository social preview`} loading="lazy" width="1200" height="630" />
          </div>
          <div class="repo-body">
            <div class="repo-top">
              <h3>{r.name}</h3>
              <span class="repo-stars">★ {r.stars}</span>
            </div>
            <p>{r.desc}</p>
            <div class="repo-meta">
              <span class="badge">{r.lang}</span>
              <span class="repo-link">View on GitHub <span class="arr">→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
