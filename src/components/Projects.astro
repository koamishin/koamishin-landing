---
const repos = [
  {
    name: 'KoamiStarterKit',
    tag: 'Flagship Starter Kit',
    img: '/repos/KoamiStarterKit.png',
    url: 'https://github.com/koamishin/KoamiStarterKit',
    docs: 'https://github.com/koamishin/KoamiStarterKit#readme',
    desc: 'An opinionated modern Laravel 12 starter kit with Vue 3, Inertia.js, Tailwind CSS, Fortify authentication, and Wayfinder routing — Octane, Pest, and CI/CD out of the box.',
    features: ['Laravel 12 + Vue 3 SPA', 'Fortify Auth & Profile', 'Pest Testing Suite', 'FrankenPHP / Octane'],
    lang: 'Laravel · Vue 3 · Inertia',
    stars: 6,
    bentoClass: 'bento-hero',
  },
  {
    name: 'koakademy',
    tag: 'Academic Management',
    img: '/repos/koakademy.png',
    url: 'https://github.com/koamishin/koakademy',
    docs: null,
    desc: 'Opinionated academic management platform for student lifecycles — enrollment, billing, scheduling & admin tools with configurable branding and PWA support.',
    features: ['Student Lifecycle', 'Enrollment & Billing', 'PWA Support'],
    lang: 'Laravel 12 · React · Inertia',
    stars: 6,
    bentoClass: 'bento-side',
  },
  {
    name: 'KoaScholarships',
    tag: 'Education & Grants',
    img: '/repos/KoaScholarships.png',
    url: 'https://github.com/koamishin/KoaScholarships',
    docs: null,
    desc: 'Streamlined scholarship application portal and admin review dashboard with automated budgeting, review stages, and disbursement workflows.',
    features: ['Applicant Portal', 'Admin Review Tools', 'Disbursement Flow'],
    lang: 'Laravel · Filament · Livewire',
    stars: 1,
    bentoClass: 'bento-third',
  },
  {
    name: 'konexus',
    tag: 'Enterprise SMIS',
    img: '/repos/konexus.png',
    url: 'https://github.com/koamishin/konexus',
    docs: null,
    desc: 'Enterprise-grade, modular School Management Information System (SMIS) built for high throughput and multi-department school operations.',
    features: ['Multi-department SMIS', 'Modular Architecture', 'Granular Permissions'],
    lang: 'Laravel 12 · PHP · Inertia',
    stars: 1,
    bentoClass: 'bento-third',
  },
  {
    name: 'konbi',
    tag: 'Store & POS Management',
    img: '/repos/konbi.png',
    url: 'https://github.com/koamishin/konbi',
    docs: null,
    desc: 'Modern Convenience Store Management System built for scalability, multi-store retail operations, real-time inventory and cashier sales.',
    features: ['Multi-store Operations', 'Real-time Inventory', 'Cashier POS'],
    lang: 'Vue 3 · Laravel · MySQL',
    stars: 1,
    bentoClass: 'bento-third',
  },
  {
    name: 'Koattendance',
    tag: 'Workforce & Timekeeping',
    img: '/repos/Koattendance.png',
    url: 'https://github.com/koamishin/Koattendance',
    docs: null,
    desc: 'Biometric time-tracking and attendance management platform for institutions with automated reporting and audit logs.',
    features: ['Biometric Logs', 'Shift Schedules', 'Automated Reports'],
    lang: 'Vue · Laravel · Inertia',
    stars: 1,
    bentoClass: 'bento-half',
  },
  {
    name: 'koment',
    tag: 'Events & Esports SaaS',
    img: '/repos/koment.png',
    url: 'https://github.com/koamishin/koment',
    docs: null,
    desc: 'Next-gen Event Management and Esports Tournament SaaS Platform with bracket generation, team rosters, and real-time match dashboards.',
    features: ['Tournament Brackets', 'Team Rosters', 'Live Scoreboards'],
    lang: 'TypeScript · Laravel · SaaS',
    stars: 1,
    bentoClass: 'bento-half',
  },
];
---
<section class="section" id="projects">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">The Shelf</span>
      <h2 class="section-title">Featured <em>repositories</em></h2>
      <p class="lede">Top open-source systems from the Koamishin collective on GitHub — production-ready, documented, tested, and free to fork.</p>
    </div>

    <div class="bento-grid">
      {repos.map((r) => (
        <article class={`bento-card ${r.bentoClass}`} data-reveal>
          <div class="bento-header">
            <span class="bento-tag">{r.tag}</span>
            <span class="bento-stars">★ {r.stars}</span>
          </div>

          <div class="bento-content">
            <div class="bento-text">
              <h3 class="bento-title">
                <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
              </h3>
              <span class="bento-lang">{r.lang}</span>
              <p class="bento-desc">{r.desc}</p>
              
              {r.features && (
                <ul class="bento-features">
                  {r.features.map((f) => (
                    <li><span class="bullet">✦</span> {f}</li>
                  ))}
                </ul>
              )}

              <div class="bento-actions">
                <a href={r.url} class="btn-bento-gh" target="_blank" rel="noopener">
                  View on GitHub <span class="arr">→</span>
                </a>
                {r.docs && (
                  <a href={r.docs} class="btn-bento-docs" target="_blank" rel="noopener">
                    Docs ↗
                  </a>
                )}
              </div>
            </div>

            <a class="bento-preview" href={r.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <img src={r.img} alt={`${r.name} repository preview`} loading="lazy" width="1200" height="630" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
