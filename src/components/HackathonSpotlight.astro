---
---
<section class="section hackathon-section" id="hackathon">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">★ Hackathon Innovation</span>
      <h2 class="section-title">Built under pressure, <em>engineered</em> to last.</h2>
      <p class="lede">Our official entry for the Circle Agent Stack × Arc Network Hackathon — pioneering bounded AI finance orchestration for institutional education.</p>
    </div>

    <div class="hackathon-card" data-reveal>
      <!-- Top Meta Bar -->
      <div class="hk-meta-bar">
        <div class="hk-tags">
          <span class="hk-badge hk-badge-event">Circle Agent Stack × Arc Hackathon</span>
          <span class="hk-badge hk-badge-status">
            <span class="status-dot"></span>
            Arc Testnet Live
          </span>
        </div>
        <div class="hk-framework">
          <span>Laravel 13 · React 19 · Inertia.js</span>
        </div>
      </div>

      <!-- Top Balanced Showcase Grid -->
      <div class="hk-body-grid">
        <!-- Left: Project Narrative & Quick CTAs -->
        <div class="hk-content">
          <div class="hk-title-group">
            <div class="hk-name-wrap">
              <h3 class="hk-name">EduFlow AI</h3>
              <span class="hk-chip">Hackathon Project</span>
            </div>
            <p class="hk-tagline">Bounded Departmental Finance Orchestration on Circle Agent Wallets + Arc</p>
          </div>

          <p class="hk-description">
            EduFlow AI demonstrates how autonomous agents and institutional treasury operations can safely converge. Built for college finance departments, EduFlow AI introduces a deterministic policy layer where AI analyzes invoices and drafts recommendations, while cryptographic settlement on Arc testnet is strictly bound by hard rules and human-in-the-loop safety gates.
          </p>

          <!-- Tech stack pills -->
          <div class="hk-tech-stack">
            <span class="dir-pill">Circle Agent Stack</span>
            <span class="dir-pill">Arc Testnet</span>
            <span class="dir-pill">Laravel 13</span>
            <span class="dir-pill">React 19</span>
            <span class="dir-pill">Inertia.js</span>
            <span class="dir-pill">Filament</span>
            <span class="dir-pill">Octane</span>
          </div>

          <!-- CTAs inline row -->
          <div class="hk-actions">
            <a class="btn btn-primary" href="https://github.com/koamishin/EduFlow" target="_blank" rel="noopener">
              Explore EduFlow AI on GitHub →
            </a>
            <a class="btn btn-ghost" href="https://github.com/koamishin/EduFlow/blob/main/PLAN.md" target="_blank" rel="noopener">
              Read Architecture Spec (PLAN.md) ↗
            </a>
          </div>
        </div>

        <!-- Right: Terminal Demonstration & Verification Stats -->
        <div class="hk-terminal-panel">
          <div class="hk-terminal-window">
            <div class="hk-terminal-bar">
              <div class="hk-terminal-dots">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <span class="hk-terminal-title">php artisan eduflow:demo</span>
            </div>
            <div class="hk-terminal-content">
              <div class="t-line dim">$ php artisan eduflow:demo</div>
              <div class="t-line t-summary">Cycle: auto-paid 3, escalated 2, held 1, disbursed 85 USDC.</div>
              <div class="t-line spacer"></div>
              <div class="t-row t-pass">
                <span class="t-type">Invoice</span>
                <span class="t-amt">30.00 USDC</span>
                <span class="t-status">AUTO_APPROVE</span>
                <span class="t-rule">VENDOR_AUTO_PAYMENT_V1</span>
              </div>
              <div class="t-row t-pass">
                <span class="t-type">Invoice</span>
                <span class="t-amt">45.00 USDC</span>
                <span class="t-status">AUTO_APPROVE</span>
                <span class="t-rule">VENDOR_AUTO_PAYMENT_V1</span>
              </div>
              <div class="t-row t-warn">
                <span class="t-type">Invoice</span>
                <span class="t-amt">60.00 USDC</span>
                <span class="t-status">ESCALATE</span>
                <span class="t-rule">VENDOR_COMPLIANCE_V1</span>
              </div>
              <div class="t-row t-warn">
                <span class="t-type">Invoice</span>
                <span class="t-amt">90.00 USDC</span>
                <span class="t-status">ESCALATE</span>
                <span class="t-rule">HIGH_VALUE_DISBURSEMENT_V1</span>
              </div>
              <div class="t-row t-hold">
                <span class="t-type">Invoice</span>
                <span class="t-amt">200.00 USDC</span>
                <span class="t-status">HOLD</span>
                <span class="t-rule">TREASURY_RESERVE_SAFETY_V1</span>
              </div>
              <div class="t-line spacer"></div>
              <div class="t-row t-aid">
                <span class="t-type">Aid</span>
                <span class="t-amt">15.00 USDC</span>
                <span class="t-status">PARTIAL_APPROVAL</span>
                <span class="t-rule">BOUNDED_EMERGENCY_AID_V1</span>
              </div>
              <div class="t-note">↳ 10.00 USDC approved instantly, 5.00 USDC escalated for review.</div>
              <div class="t-line spacer"></div>
              <div class="t-chain-row">
                <span class="t-chain-tag">CHAIN</span>
                <span class="t-chain-info">Arc Testnet · Circle Agent Wallet 0x8a1...f4e</span>
              </div>
            </div>
          </div>
          
          <div class="hk-stat-card">
            <div class="hk-stat-item">
              <span class="hk-stat-num">100%</span>
              <span class="hk-stat-label">Deterministic Control</span>
            </div>
            <div class="hk-stat-sep"></div>
            <div class="hk-stat-item">
              <span class="hk-stat-num">6 Dec</span>
              <span class="hk-stat-label">Exact USDC Math</span>
            </div>
            <div class="hk-stat-sep"></div>
            <div class="hk-stat-item">
              <span class="hk-stat-num">Arc</span>
              <span class="hk-stat-label">On-chain Verification</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Horizontal 3-Column Pillars Grid (Eliminates dead space) -->
      <div class="hk-pillars-grid">
        <div class="hk-pillar">
          <div class="hk-pillar-dot">01</div>
          <div class="hk-pillar-text">
            <b>Deterministic Safety Layer</b>
            <span>The LLM never moves money. Policy checks execute in plain typed PHP; AI only drafts proposals and explains decisions.</span>
          </div>
        </div>

        <div class="hk-pillar">
          <div class="hk-pillar-dot">02</div>
          <div class="hk-pillar-text">
            <b>Circle Agent Wallets &amp; Arc</b>
            <span>Autonomous agent gateways via Lepton, executing verified USDC mirror settlements with on-chain finality tracking.</span>
          </div>
        </div>

        <div class="hk-pillar">
          <div class="hk-pillar-dot">03</div>
          <div class="hk-pillar-text">
            <b>College Shadow Pilot Ready</b>
            <span>Engineered for real departmental budgets, vendor invoice auditing, and dual-lane automated execution.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
