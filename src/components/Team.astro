---
const team = [
  {
    name: 'Louis',
    handle: '@Rui-Zen',
    handleAlt: '@yukazakiri',
    roles: ['Founder · Lead Engineer', 'Full Stack Engineer'],
    bio: 'Founder and principal architect of Koamishin. Drives core framework design, starter kit infrastructure, and multi-tenant platforms with a relentless focus on backend resilience, developer ergonomics, and clean open-source standards.',
    stack: 'Laravel · Vue · PHP · TypeScript',
    img: '/team/Rui-Zen.png',
    github: 'https://github.com/Rui-Zen',
    githubAlt: 'https://github.com/yukazakiri',
    portfolio: 'https://louis.koamishin.com',
  },
  {
    name: 'Ortiz Bugtong Jr',
    handle: '@SorenOutis',
    roles: ['Full Stack Developer', 'AI Engineer'],
    bio: 'Full-stack and AI engineer blending reactive Laravel & Vue architectures with intelligent workflow automation. Specializes in scalable data systems, AI-augmented tooling, and bridging complex backend logic with polished visual interfaces.',
    stack: 'Laravel · Vue · System Arch',
    img: '/team/SorenOutis.png',
    github: 'https://github.com/SorenOutis',
    portfolio: 'https://ob.koamishin.com',
  },
  {
    name: 'Jaymark',
    handle: '@jayreid017',
    roles: ['UI/UX Designer'],
    bio: 'Lead UI/UX designer championing human-centered design systems, usability benchmarks, and thorough quality assurance. Crafts clean interface patterns, accessible design tokens, and seamless user journeys from concept to production.',
    stack: 'Figma · React · Testing',
    img: '/team/Jaymark.png',
    github: 'https://github.com/jAymarkbacurin',
    portfolio: null,
  },
  {
    name: 'Angelika',
    handle: '@elyashzyl',
    roles: ['Frontend Developer'],
    bio: 'Frontend developer engineering modern React interfaces, modular component systems, and responsive web applications. Dedicated to crafting thoughtful, accessible user interfaces across the collective’s open-source platforms.',
    stack: 'React · TypeScript · Laravel',
    img: '/team/Angelika.png',
    github: 'https://github.com/elyashzyl',
    portfolio: 'https://ely.koamishin.com',
  },
];
---
<section class="section" id="team" style="background:var(--cream-2)">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">The Collective</span>
      <h2 class="section-title">The team behind <em>Koamishin</em></h2>
      <p class="lede">A small, global, remote collective — engineers and designers who publish what they build so the wider community can pick up the tools.</p>
    </div>
    <div class="team-grid">
      {team.map((m) => (
        <article class="team-card" data-reveal>
          <a class="team-photo" href={m.portfolio || m.github} target="_blank" rel="noopener">
            <img src={m.img} alt={`${m.name} profile photo`} loading="lazy" width="200" height="200" />
          </a>
          <div class="team-info">
            <h3>{m.name}</h3>
            <div class="team-handles">
              <a class="team-handle" href={m.github} target="_blank" rel="noopener">{m.handle}</a>
              {m.handleAlt && (
                <span class="team-handle-sep">·</span>
                <a class="team-handle" href={m.githubAlt} target="_blank" rel="noopener" title="Secondary GitHub">{m.handleAlt}</a>
              )}
            </div>
            <div class="team-roles">
              {m.roles.map((r) => <span class="badge">{r}</span>)}
            </div>
            <span class="team-stack">{m.stack}</span>
            <p>{m.bio}</p>
            <div class="team-meta">
              {m.portfolio && (
                <a class="team-portfolio-link" href={m.portfolio} target="_blank" rel="noopener">
                  Portfolio <span class="arr">↗</span>
                </a>
              )}
              <a class="repo-link" href={m.github} target="_blank" rel="noopener">
                GitHub <span class="arr">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
