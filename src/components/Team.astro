---
const team = [
  {
    name: 'yukazakiri', handle: 'Yuka', roles: ['Founder · Lead Engineer'],
    bio: 'Primary author of the collective — 400 contributions across 7 repositories: starter kits, POS, scholarships, attendance and the site itself.',
    stack: 'Laravel · Vue · Inertia',
    img: '/team/yukazakiri.png', commits: 400, url: 'https://github.com/yukazakiri',
  },
  {
    name: 'Ortiz Bugtong Jr', handle: '@SorenOutis', roles: ['Full Stack Developer', 'AI Engineer'],
    bio: 'Full-stack builds, infrastructure flow, and visual systems. Shapes full-stack work with a visual eye.',
    stack: 'Laravel · Vue · System Arch',
    img: '/team/SorenOutis.png', commits: 126, url: 'https://github.com/SorenOutis',
  },
  {
    name: 'Jaymark', handle: '@jayreid017', roles: ['UI/UX Designer'],
    bio: 'Interface systems, usability passes, and quality review. Designs with care and tests with patience.',
    stack: 'Figma · React · Testing',
    img: '/team/Jaymark.png', commits: 2, url: 'https://github.com/jAymarkbacurin',
  },
  {
    name: 'Louis', handle: '@Rui-Zen', roles: ['Full Stack Engineer'],
    bio: 'Technical direction, deployment paths, and system reliability. Keeps systems clear, steady, and shippable.',
    stack: 'PHP · TypeScript · Writing',
    img: '/team/Rui-Zen.png', commits: 1, url: 'https://github.com/Rui-Zen',
  },
  {
    name: 'Angelika', handle: '@elyashzyl', roles: ['Developer'],
    bio: 'React interfaces, Laravel features, and ecosystem support. Builds thoughtful pieces for the Koamishin ecosystem.',
    stack: 'React · TypeScript · Laravel',
    img: '/team/Angelika.png', commits: 0, url: 'https://github.com/elyashzyl',
  },
];
---
<section class="section" id="team" style="background:var(--cream-2)">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">The Collective</span>
      <h2 class="section-title">The team behind <em>Koamishin</em></h2>
      <p class="lede">A small, global, remote collective — engineers and designers who publish what they build so the wider community can pick up the tools. Roles &amp; stacks from the official roster; profile photos from GitHub.</p>
    </div>
    <div class="team-grid">
      {team.map((m) => (
        <a class="team-card" href={m.url} target="_blank" rel="noopener" data-reveal>
          <div class="team-photo">
            <img src={m.img} alt={`${m.name} GitHub profile photo`} loading="lazy" width="200" height="200" />
          </div>
          <div class="team-info">
            <h3>{m.name}</h3>
            <span class="team-handle">{m.handle}</span>
            <div class="team-roles">
              {m.roles.map((r) => <span class="badge">{r}</span>)}
            </div>
            <span class="team-stack">{m.stack}</span>
            <p>{m.bio}</p>
            <div class="team-meta">
              <span class="team-commits"><b>{m.commits}</b> contributions</span>
              <span class="repo-link">GitHub <span class="arr">→</span></span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
