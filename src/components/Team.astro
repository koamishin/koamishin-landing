---
const team = [
  {
    name: 'yukazakiri',
    handle: 'Yuka',
    roles: ['Founder · Lead Engineer'],
    bio: 'Primary author of the collective — starter kits, POS, scholarships, attendance and the site itself.',
    stack: 'Laravel · Vue · Inertia',
    img: '/team/yukazakiri.png',
    github: 'https://github.com/yukazakiri',
    portfolio: null,
  },
  {
    name: 'Ortiz Bugtong Jr',
    handle: '@SorenOutis',
    roles: ['Full Stack Developer', 'AI Engineer'],
    bio: 'Full-stack builds, infrastructure flow, and visual systems. Shapes full-stack work with a visual eye.',
    stack: 'Laravel · Vue · System Arch',
    img: '/team/SorenOutis.png',
    github: 'https://github.com/SorenOutis',
    portfolio: 'https://ob.koamishin.com',
  },
  {
    name: 'Jaymark',
    handle: '@jayreid017',
    roles: ['UI/UX Designer'],
    bio: 'Interface systems, usability passes, and quality review. Designs with care and tests with patience.',
    stack: 'Figma · React · Testing',
    img: '/team/Jaymark.png',
    github: 'https://github.com/jAymarkbacurin',
    portfolio: null,
  },
  {
    name: 'Louis',
    handle: '@Rui-Zen',
    roles: ['Full Stack Engineer'],
    bio: 'Technical direction, deployment paths, and system reliability. Keeps systems clear, steady, and shippable.',
    stack: 'PHP · TypeScript · Writing',
    img: '/team/Rui-Zen.png',
    github: 'https://github.com/Rui-Zen',
    portfolio: 'https://louis.koamishin.com',
  },
  {
    name: 'Angelika',
    handle: '@elyashzyl',
    roles: ['Developer'],
    bio: 'React interfaces, Laravel features, and ecosystem support. Builds thoughtful pieces for the Koamishin ecosystem.',
    stack: 'React · TypeScript · Laravel',
    img: '/team/Angelika.png',
    github: 'https://github.com/elyashzyl',
    portfolio: 'https://ely.koamishin.com',
  },
];
---
<section class="section" id="team" style="background:var(--cream-2)">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="kicker">The Collective</span>
      <h2 class="section-title">The team behind <em>Koamishin</em></h2>
      <p class="lede">A small, global, remote collective — engineers and designers who publish what they build so the wider community can pick up the tools.</p>
    </div>
    <div class="team-grid">
      {team.map((m) => (
        <article class="team-card" data-reveal>
          <a class="team-photo" href={m.portfolio || m.github} target="_blank" rel="noopener">
            <img src={m.img} alt={`${m.name} profile photo`} loading="lazy" width="200" height="200" />
          </a>
          <div class="team-info">
            <h3>{m.name}</h3>
            <a class="team-handle" href={m.github} target="_blank" rel="noopener">{m.handle}</a>
            <div class="team-roles">
              {m.roles.map((r) => <span class="badge">{r}</span>)}
            </div>
            <span class="team-stack">{m.stack}</span>
            <p>{m.bio}</p>
            <div class="team-meta">
              {m.portfolio && (
                <a class="team-portfolio-link" href={m.portfolio} target="_blank" rel="noopener">
                  Portfolio <span class="arr">↗</span>
                </a>
              )}
              <a class="repo-link" href={m.github} target="_blank" rel="noopener">
                GitHub <span class="arr">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
