<section class="hero" id="hero">
  <div class="wrap hero-center">
    <div class="badges" data-reveal>
      <span class="badge coral">Open Source</span>
      <span class="badge teal">Laravel 12 &amp; 13</span>
      <span class="badge gold">Full-Stack Ecosystem</span>
    </div>
    <h1 class="hero-title" data-words>Laravel <em>artisans</em>, working in the open.</h1>
    <p class="hero-deck" data-reveal>Koamishin is a growing collective of Laravel artisans — engineers and designers devoted to craft, clarity, and open-source work. We learn in public, hold a high bar, and keep the workshop doors open.</p>
    <div class="hero-ctas" data-reveal>
      <a class="btn btn-primary" href="#projects">Explore the Projects →</a>
      <a class="btn btn-ghost" href="#quickstart">Quick Start Terminal</a>
    </div>
    <div class="hero-proof" data-reveal>
      <div class="avatars" aria-hidden="true">
        <img src="/team/Rui-Zen.png" alt="" width="34" height="34" loading="lazy" />
        <img src="/team/SorenOutis.png" alt="" width="34" height="34" loading="lazy" />
        <img src="/team/Jaymark.png" alt="" width="34" height="34" loading="lazy" />
        <img src="/team/Angelika.png" alt="" width="34" height="34" loading="lazy" />
      </div>
      <p><b>growing Laravel collective</b> · <b>7 open-source systems</b> · <b>every repo free to fork</b></p>
    </div>
  </div>
</section>
