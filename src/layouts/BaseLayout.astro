---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title = 'Koamishin — Open Source Laravel Collective',
  description = 'Koamishin is a growing collective of Laravel artisans — engineers and designers devoted to craft, clarity, and open-source work.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://koamishin.com');
const imageURL = new URL(image, 'https://koamishin.com');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#3C4D3D" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title="Koamishin Journal" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" hreflang="x-default" href="https://koamishin.com/" />
  <link rel="alternate" hreflang="en" href="https://koamishin.com/" />

  <!-- Agentic Resource Discovery (ARD) -->
  <link rel="ard" href="/.well-known/ard.json" />

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Koamishin" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1024" />
  <meta property="og:image:height" content="1024" />
  <meta property="og:image:alt" content="Koamishin Emblem Logo" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />

  <!-- Google Fonts Preconnect & Async Stylesheet -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Spline+Sans+Mono:wght@400;500;600&family=Work+Sans:ital,wght@0,300..700;1,400..600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Spline+Sans+Mono:wght@400;500;600&family=Work+Sans:ital,wght@0,300..700;1,400..600&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Spline+Sans+Mono:wght@400;500;600&family=Work+Sans:ital,wght@0,300..700;1,400..600&display=swap" />
  </noscript>

  <!-- Structured Data (JSON-LD) with Rich Entity Graph -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://koamishin.com/#website",
          "url": "https://koamishin.com/",
          "name": "Koamishin",
          "description": "Open Source Laravel Collective crafting high-performance starter kits, enterprise platforms, and tools.",
          "publisher": {
            "@id": "https://koamishin.com/#organization"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://koamishin.com/#organization",
          "name": "Koamishin",
          "alternateName": "Koamishin Collective",
          "url": "https://koamishin.com",
          "logo": "https://koamishin.com/koamishin-logo.png",
          "sameAs": [
            "https://github.com/koamishin",
            "https://x.com"
          ],
          "description": "An open-source developer collective crafting refined Laravel starter kits, institutional platforms, and developer tooling."
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://koamishin.com/#opensinop",
          "name": "OpenSinop",
          "applicationCategory": "BusinessApplication",
          "operatingSystem": "Web",
          "url": "https://opensinop.koamishin.com/",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "description": "Bounded departmental finance orchestration on Circle Agent Wallets and Arc Testnet."
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://koamishin.com/#koamistarterkit",
          "name": "KoamiStarterKit",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Cross-platform",
          "url": "https://github.com/koamishin/KoamiStarterKit",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "description": "Modern Laravel 12 + Vue 3 + Inertia.js + Tailwind CSS 4 starter kit."
        }
      ]
    }
  </script>

  <!-- Matomo analytics (production only — keeps dev traffic out of the reports) -->
  {import.meta.env.PROD && (
    <script is:inline>
      var _paq = window._paq = window._paq || [];
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(['trackPageView']);
      _paq.push(['enableLinkTracking']);
      (function () {
        var u = 'https://matomo.koamishin.com/';
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '1']);
        var d = document,
          g = d.createElement('script'),
          s = d.getElementsByTagName('script')[0];
        g.async = true;
        g.src = u + 'matomo.js';
        s.parentNode.insertBefore(g, s);
      })();
    </script>
    <noscript>
      <p>
        <img
          referrerpolicy="no-referrer-when-downgrade"
          src="https://matomo.koamishin.com/matomo.php?idsite=1&amp;rec=1"
          style="border: 0"
          alt=""
        />
      </p>
    </noscript>
  )}

  <script is:inline>
    document.documentElement.classList.add("js");
  </script>
</head>
<body>
  <SiteHeader />
  <main id="top">
    <slot />
  </main>
  <SiteFooter />
</body>
</html>
