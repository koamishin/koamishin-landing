---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Koamishin — Open Source Laravel Collective',
  description = 'Koamishin is a developer collective crafting secure, high-performance Laravel applications and open-source packages — starter kits, POS, education systems and more, built in the open.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#26211B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Spline+Sans+Mono:wght@400;500;600&family=Work+Sans:ital,wght@0,300..700;1,400..600&display=swap" rel="stylesheet" />
  <script is:inline>
    document.documentElement.classList.add("js");
    window.__animOK = false;
    window.addEventListener("load", function () {
      setTimeout(function () {
        if (!window.__animOK) document.documentElement.classList.remove("js");
      }, 2500);
    });
  </script>
</head>
<body>
  <SiteHeader />
  <main>
    <slot />
  </main>
  <SiteFooter />
</body>
</html>
